{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magpie.local/agent-os/role-capability.schema.json",
  "title": "Role capability manifest",
  "description": "Structure of .ai/policies/role-permissions.yaml. Cross-field rules (known capabilities, no can/cannot overlap, never-grantable capabilities, escalation targets, profile files) are enforced by tools/validate_constitution.py because JSON Schema cannot express them.",
  "type": "object",
  "required": ["version", "status", "capabilities", "roles"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": ["proposed", "accepted", "superseded"]
    },
    "capabilities": {
      "description": "Closed vocabulary of capabilities. A role may only reference names defined here.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/role" }
    }
  },
  "$defs": {
    "capabilityList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "role": {
      "type": "object",
      "required": ["profile", "can", "cannot", "escalates_to"],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "description": "Path to the role profile, relative to the .ai directory.",
          "type": "string",
          "pattern": "^roles/[a-z][a-z0-9-]*\\.md$"
        },
        "can": { "$ref": "#/$defs/capabilityList" },
        "cannot": { "$ref": "#/$defs/capabilityList" },
        "escalates_to": {
          "description": "Role names, or 'human' for the human project owner.",
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
